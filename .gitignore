# ==============================================================================
# Astro & Starlight Documentation Website (gh-pages)
# ==============================================================================

# Build output
dist/

# Generated types and cache
.astro/

# Package dependencies
node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables
.env
.env.production
.env.bak
.env.lock
.env.tmp.*

# Local reference repositories and guides
master/
opensourcepos.wiki/
opensourceposguide.com/

# ==============================================================================
# Master Branch Compatibility (Ignored when switching branches)
# ==============================================================================

# PHP & Composer
vendor/
auth.json

# CodeIgniter 4 runtime and generated files
writable/
/app/Config/email.php
/app/Database/database.sql

# Docker runtime data
docker/data/database/db/*
docker/data/certbot/conf/*
docker/data/ospos/app/*
!docker/.env

# Master front-end assets & builds (Bower / Grunt)
public/resources/
public/license/*
!public/license/.gitkeep
public/images/menubar/*
!public/images/menubar/.gitkeep
build/
!tools/build/
generate_languages.php
translations/
patches/
*.patch

# NOTE: master/.gitignore ignores *.png, *.jpg, *.jpeg, *.webp, and *copy*.
# These are intentionally NOT ignored here so documentation screenshots
# and illustrations in src/ and public/ can be tracked.

# ==============================================================================
# Editors & IDEs
# ==============================================================================

## VisualStudioCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

## JetBrains / WebStorm / PhpStorm
/.idea
modules.xml
*.ipr
*.iml
/.buildpath
/.project
/.settings/*

## SublimeText
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache
*.sublime-workspace

## Vim & Backup files
*.sw[a-p]
*.swp
*.bak
*.orig
*.rej
*~
*.~

